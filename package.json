{
  "name": "xiaodao-email-parser",
  "version": "1.0.5",
  "description": "Node.js and TypeScript email parser with auto-detection for Outlook MSG and RFC 5322/MIME EML files",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "msg",
    "eml",
    "mime",
    "rfc5322",
    "rfc822",
    "outlook",
    "email",
    "parser",
    "ole2",
    "cfb",
    "mapi",
    "microsoft",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "README.ZH.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "npm run build && npm test",
    "test": "node --import tsx --test test/*.test.ts",
    "test:example": "node --import tsx examples/parse.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "cfb": "^1.2.2",
    "postal-mime": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaodaozhi/xiaodao-email-parser.git"
  },
  "homepage": "https://github.com/xiaodaozhi/xiaodao-email-parser#readme",
  "bugs": {
    "url": "https://github.com/xiaodaozhi/xiaodao-email-parser/issues"
  }
}
